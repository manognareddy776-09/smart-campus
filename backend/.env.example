# Smart Campus Backend Configuration
PROJECT_NAME="Smart Campus Lost & Found"
API_V1_STR="/api"
SECRET_KEY="super-secret-campus-lost-found-jwt-key-2026-production-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite local fallback)
DATABASE_URL="sqlite:///./lostfound.db"
# Production Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# Supabase Storage (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="lostfound-items"
