# ==========================================
# SMART CAMPUS LOST & FOUND - ENVIRONMENT CONFIGURATION
# ==========================================

# ----------------- BACKEND CONFIG -----------------
PROJECT_NAME="Smart Campus Lost & Found"
API_V1_STR="/api"
SECRET_KEY="super-secret-campus-lost-found-jwt-key-2026-production-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# Default local development fallback: SQLite
DATABASE_URL="sqlite:///./lostfound.db"
# Supabase PostgreSQL connection string for production:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# File Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

# Supabase Storage Optional Configuration
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="lostfound-items"

# CORS Allowed Origins (Comma separated in production if needed)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ----------------- FRONTEND CONFIG -----------------
VITE_API_BASE_URL="http://127.0.0.1:8000"
